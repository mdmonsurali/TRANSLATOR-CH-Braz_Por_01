CHANDRA_MODEL=datalab-to/chandra-ocr-2
OCR_MODEL_NAME=chandra
# HuggingFace token, only needed at BUILD time if the model repo is gated.
HF_TOKEN=

# Ports (host -> container)
OCR_SERVICE_PORT=8001
UI_SERVICE_PORT=8000
VLLM_PORT=8888

# GPU 
GPU_DEVICE_ID=0
TRANSLATOR_GPU_DEVICE_ID=0


GPU_MEM_UTIL=0.85

# Context window per request. Chandra-2 is HYBRID: only 8 of its 32 layers are
# full_attention (24 are linear/Mamba, constant state), so KV grows at ~32KiB per
# token, not 128KiB. vLLM reports the pool as 19.30x @ 12288 => ~237k attention
# tokens at GPU_MEM_UTIL=0.85. 12 slots x 24576 = 294912 is ~1.2x oversubscribed:
# vLLM pages on demand and PREEMPTS rather than OOMing, which is acceptable here
# because measured KV usage is only 25-33%. Guaranteed-fit at 12 slots is 19456.
# Do NOT raise GPU_MEM_UTIL to buy more -- GPU_SWAP needs the headroom to start
# translator_service (Qwen3-14B Q8_0, 14.6GiB).
MAX_MODEL_LEN=24576

VLLM_MAX_NUM_SEQS=12

OCR_BATCH_SIZE_NATIVE=16
OCR_BATCH_SIZE_SCANNED=8
OCR_BATCH_SIZE=2

OCR_PAGE_WINDOW=32

OCR_MAX_PAGES=0
PDF_RENDER_DPI=300
OCR_MEM_LIMIT=24G

PREVIEW_TIMEOUT_SEC=600

# Output cap. MUST stay below MAX_MODEL_LEN with room for the image + prompt
# tokens, or vLLM clamps generation to (MAX_MODEL_LEN - prompt) and pages get
# truncated silently. 24576 - 2048 = 22528.
OCR_MAX_TOKENS=22528

# Retry a page when its output looks like a repeat-token loop. DEFAULT FALSE.
OCR_REPEAT_RETRY=true
OCR_MAX_RETRIES=2

OCR_REQUEST_TIMEOUT_SEC=600

# Rotated-table support (detect rotation -> re-OCR the table upright -> render the
# page landscape). MASTER SWITCH for the whole chain. DEFAULT FALSE.
#
# false: nothing is detected, no extra OCR calls, every page renders UPRIGHT.
#        Rotated tables will have squashed columns and may be clipped.
# true : rotated tables are detected, re-read upright (recovering cells the
#        sideways read drops) and rendered on a landscape page.
#
# Why off by default — measured on a 168-page document: 151 table probes ran and
# only 32 found rotation, so 119 probes (~24 min of PaddleOCR time) went to
# confirming tables were already upright. Each accepted repair also costs one
# extra model call on a crop that is ~96% of a full page's pixels.
#
# Turn it ON for landscape QC/inspection scans on portrait sheets.
# Overrides for debugging ONE stage (normally leave unset — detection on with
# re-OCR off flips pages to landscape without recovering their dropped cells):
#   OCR_DETECT_ROTATION, OCR_DETECT_ROTATION_TABLES, OCR_REOCR_ROTATED_TABLES
OCR_ROTATION=true

# Formula rendering style
FORMULA_SIZE_MULTIPLIER=1.6
FORMULA_BOLD=true

# Picture / figure handling 
INCLUDE_PICTURES=true

# Per-entry font/size/bold/italic/color attribution.
ATTRIBUTE_STYLES=true

# Postgres (metadata store)
POSTGRES_DB=ocr
POSTGRES_USER=ocr
POSTGRES_PASSWORD=changeme

# MinIO (object store) 
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=changeme
MINIO_BUCKET=ocr
MINIO_REGION=us-east-1
MINIO_SECURE=false
MINIO_CONSOLE_PORT=9001
# Max simultaneous PUTs per document (decoupled from OCR_BATCH_SIZE_*).
MINIO_UPLOAD_CONCURRENCY=8

# Auth service
AUTH_SERVICE_PORT=8002

MASTER_USERNAME=master
MASTER_PASSWORD=changeme-please
# How long a login lasts before the user must sign in again.
SESSION_TTL_HOURS=12
# Set to true when the UI is served over HTTPS (sets the Secure cookie flag).
COOKIE_SECURE=false

# Translator service (llama.cpp Qwen3 14B Q8_0)
#
# THE INVARIANT THAT MATTERS: llama.cpp splits total context across slots, so
#     per-slot context = LLAMA_CTX_SIZE / LLAMA_PARALLEL
# and TRANSLATE_MAX_TOKENS (the OUTPUT budget) must stay well BELOW that number.
# Violating it is what caused 55 chunks in a 168-page run to degrade to per-item
# translation (~40 requests instead of 1) plus 8 outright 400s: at 8192/4 = 2048
# tokens per slot with TRANSLATE_MAX_TOKENS=4096, the output budget alone was
# DOUBLE the slot, so a 40-item JSON reply was truncated, the item count
# mismatched, and the chunk fell back.
#
# NEVER raise LLAMA_PARALLEL without raising LLAMA_CTX_SIZE by the same factor —
# more slots means SMALLER slots, which makes this failure worse.
#
# 32768/4 = 8192 per slot: 4096 for output, 4096 for the prompt. Worst-case
# prompt measured ~2700-3000 tokens (a 4000-byte CJK chunk is ~1333 tokens, and
# `_sep_hint` in translation.py sends every item TWICE, plus system prompt and
# JSON scaffolding), so it fits with margin.
#
# VRAM: verified by loading this exact config on the 23 GiB A10G — 19.7 GiB used,
# 2.8 GiB free. Weights are 14.6 GiB and KV costs only ~0.156 MiB/token, so
# context is cheap here.
#
# An earlier note claimed LLAMA_CTX_SIZE=16384 "killed llama-server on startup"
# for lack of VRAM. That was a MISDIAGNOSIS: the real error was `cudaMalloc
# failed` while allocating WEIGHTS, because ocr_service still held 18 GB of the
# card at the time. GPU_SWAP=true keeps the two models from ever coexisting, so
# the translator gets the whole GPU. If llama-server ever does fail to start it
# fails fast — step down to 24576, then 16384.
LLAMA_CTX_SIZE=32768
LLAMA_PARALLEL=4
TRANSLATE_CONCURRENCY=4
# Output ceiling per request. Must be < LLAMA_CTX_SIZE / LLAMA_PARALLEL (8192).
TRANSLATE_MAX_TOKENS=4096

TRANSLATE_PAGE_WINDOW=25

TRANSLATE_REQUEST_TIMEOUT_SEC=600

TRANSLATE_CHUNK_ITEMS=40
TRANSLATE_CHUNK_BYTES=4000

OCR_TIMEOUT_SEC=86400        # 24h safety net
TRANSLATE_TIMEOUT_SEC=86400  # 24h safety net

# Orchestrator service
GPU_SWAP=true

SWAP_HEALTH_TIMEOUT_SEC=300
